# Phase 1 tests: basic expressions and assignments

# Simple assignment
x = 1
y = 2

# Arithmetic
z = x + y

---

# More arithmetic
a = 10
b = 3
c = a - b

---

# Multiplication
p = 5
q = 4
r = p * q

---

# Division (returns float)
m = 10
n = 4
o = m / n

---

# Floor division
d = 10
e = 3
f = d // e

---

# Modulo
g = 10
h = 3
i = g % h

---

# String literals
s = "hello"
t = "world"

---

# Boolean literals
flag1 = True
flag2 = False

---

# Comparisons
v = 5 < 10
w = 5 > 10
x1 = 5 == 5
x2 = 5 != 5
x3 = 3 <= 3
x4 = 3 >= 3

---

# Complex expression
result = (10 + 5) * 2 - 3
