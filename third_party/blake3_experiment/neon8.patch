+static void blake3_hash8_neon(const uint8_t *const *inputs, size_t blocks,
+                       const uint32_t key[8], uint64_t counter,
+                       bool increment_counter, uint8_t flags,
+                       uint8_t flags_start, uint8_t flags_end, uint8_t *out) {
+  u32x8 h_vecs[8];
+  for (int i = 0; i < 8; i++) h_vecs[i] = set1_8(key[i]);
+  u32x8 counter_low_vec, counter_high_vec;
+  load_counters4(counter, increment_counter, &counter_low_vec.a, &counter_high_vec.a);
+  load_counters4(counter + (increment_counter ? 4 : 0), increment_counter,
+                 &counter_low_vec.b, &counter_high_vec.b);
+  uint8_t block_flags = flags | flags_start;
+  for (size_t block = 0; block < blocks; block++) {
+    if (block + 1 == blocks) {
+      block_flags |= flags_end;
+    }
+    u32x8 block_len_vec = set1_8(BLAKE3_BLOCK_LEN);
+    u32x8 block_flags_vec = set1_8(block_flags);
+    uint32x4_t msg_a[16], msg_b[16];
+    transpose_msg_vecs4(inputs, block * BLAKE3_BLOCK_LEN, msg_a);
+    transpose_msg_vecs4(inputs + 4, block * BLAKE3_BLOCK_LEN, msg_b);
+    u32x8 msg_vecs[16];
+    for (int i = 0; i < 16; i++) { msg_vecs[i].a = msg_a[i]; msg_vecs[i].b = msg_b[i]; }
+    u32x8 v[16] = {
+        h_vecs[0],     h_vecs[1],      h_vecs[2],     h_vecs[3],
+        h_vecs[4],     h_vecs[5],      h_vecs[6],     h_vecs[7],
+        set1_8(IV[0]), set1_8(IV[1]),  set1_8(IV[2]), set1_8(IV[3]),
+        counter_low_vec, counter_high_vec, block_len_vec, block_flags_vec,
+    };
+    round_fn8(v, msg_vecs, 0);
+    round_fn8(v, msg_vecs, 1);
+    round_fn8(v, msg_vecs, 2);
+    round_fn8(v, msg_vecs, 3);
+    round_fn8(v, msg_vecs, 4);
+    round_fn8(v, msg_vecs, 5);
+    round_fn8(v, msg_vecs, 6);
+    for (int i = 0; i < 8; i++) h_vecs[i] = xor8(v[i], v[i + 8]);
+    block_flags = flags;
+  }
+  for (int half = 0; half < 2; half++) {
+    uint32x4_t hv[8];
+    for (int i = 0; i < 8; i++) hv[i] = half ? h_vecs[i].b : h_vecs[i].a;
+    transpose_vecs_128(&hv[0]);
+    transpose_vecs_128(&hv[4]);
+    uint8_t *o = &out[half * 4 * BLAKE3_OUT_LEN];
+    storeu_128(hv[0], &o[0 * sizeof(uint32x4_t)]);
+    storeu_128(hv[4], &o[1 * sizeof(uint32x4_t)]);
+    storeu_128(hv[1], &o[2 * sizeof(uint32x4_t)]);
+    storeu_128(hv[5], &o[3 * sizeof(uint32x4_t)]);
+    storeu_128(hv[2], &o[4 * sizeof(uint32x4_t)]);
+    storeu_128(hv[6], &o[5 * sizeof(uint32x4_t)]);
+    storeu_128(hv[3], &o[6 * sizeof(uint32x4_t)]);
+    storeu_128(hv[7], &o[7 * sizeof(uint32x4_t)]);
+  }
