+package com.google.devtools.build.lib.vfs;
+
+import java.lang.invoke.MethodHandles;
+import java.lang.invoke.VarHandle;
+import java.nio.ByteOrder;
+import javax.annotation.Nullable;
+import jdk.internal.vm.annotation.LooselyConsistentValue;
+
+/**
+ * A 256-bit digest (e.g. SHA-256) stored inline as four longs.
+ *
+ * <p>As a loosely consistent value class, a {@code @NullRestricted} field of this type is flattened
+ * into its holder (32 bytes) instead of pointing to a separate {@code byte[32]} (48 bytes).
+ */
+@LooselyConsistentValue
+public value class Digest256 {
+  public static final int LENGTH = 32;
+
+  private static final VarHandle LONGS =
+      MethodHandles.byteArrayViewVarHandle(long[].class, ByteOrder.BIG_ENDIAN);
+
+  private final long d0;
+  private final long d1;
+  private final long d2;
+  private final long d3;
+
+  private Digest256(byte[] digest) {
+    this.d0 = (long) LONGS.get(digest, 0);
+    this.d1 = (long) LONGS.get(digest, 8);
+    this.d2 = (long) LONGS.get(digest, 16);
+    this.d3 = (long) LONGS.get(digest, 24);
+  }
+
+  public static boolean fits(@Nullable byte[] digest) {
+    return digest != null && digest.length == LENGTH;
+  }
+
+  public static Digest256 of(byte[] digest) {
+    if (digest.length != LENGTH) {
+      throw new IllegalArgumentException("Expected 32 bytes, got " + digest.length);
+    }
+    return new Digest256(digest);
+  }
+
+  public byte[] toBytes() {
+    byte[] b = new byte[LENGTH];
+    LONGS.set(b, 0, d0);
+    LONGS.set(b, 8, d1);
+    LONGS.set(b, 16, d2);
+    LONGS.set(b, 24, d3);
+    return b;
+  }
+
+  public boolean equalsBytes(@Nullable byte[] other) {
+    return other != null
+        && other.length == LENGTH
+        && d0 == (long) LONGS.get(other, 0)
+        && d1 == (long) LONGS.get(other, 8)
+        && d2 == (long) LONGS.get(other, 16)
+        && d3 == (long) LONGS.get(other, 24);
+  }
+
+  @Override
+  public boolean equals(Object o) {
+    return o instanceof Digest256 that
+        && d0 == that.d0
+        && d1 == that.d1
+        && d2 == that.d2
+        && d3 == that.d3;
+  }
+
+  @Override
+  public int hashCode() {
+    // The digest is already uniformly distributed.
+    return (int) (d0 ^ (d0 >>> 32));
+  }
+}
